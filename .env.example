# Copy this file to ".env" to change the Docker Compose defaults.

# Port on your computer for the web application (http://localhost:8085)
APP_PORT=8085
# Port on your computer for MySQL (for MySQL Workbench / IntelliJ Database tool)
DB_PORT=3385

DB_PASSWORD=evoting123
DB_ROOT_PASSWORD=root123

# Admin account created the first time the application starts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to derive the vote encryption keys. Do not change it after votes have been cast.
SECURITY_SECRET=change-this-secret-key-for-your-election-2026
